    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const currentPath = window.location.pathname;
            // Desktop nav active state
            const navLinks = document.querySelectorAll('.header-nav .nav-item > a.nav-link');
            navLinks.forEach(link => {
                const linkPath = link.getAttribute('href');
                if (linkPath === currentPath) {
                    link.classList.remove('text-muted');
                    link.classList.add('text-dark');
                    link.style.background = 'rgba(0,0,0,0.05)';
                } else if (linkPath !== '#') {
                    link.classList.remove('text-dark');
                    link.classList.add('text-muted');
                    link.style.background = 'transparent';
                }
            });
            // Mobile nav active state
            const mobileLinks = document.querySelectorAll('#mobileNavLinks .nav-item > a.nav-link');
            mobileLinks.forEach(link => {
                const linkPath = link.getAttribute('href');
                if (linkPath === currentPath) {
                    link.style.background = 'rgba(73, 135, 164, 0.1)';
                    link.style.color = '#4987A4';
                }
            });
        });
    </script>
