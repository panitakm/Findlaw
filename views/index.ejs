<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>FindLawyer</title>
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    </head>
<body class="fade-in d-flex flex-column min-vh-100" style="overflow-x: hidden;">
    <%- include('partials/navbar') %>


  <main class="swiper main-swiper vh-100 w-100"> 
    <div class="swiper-wrapper">
    <!-- SNAP SECTION 1: Banner & Search Box -->
    <div class="swiper-slide snap-section d-flex flex-column" style="min-height: 100vh;">
    <section class="title text-center" id="topBanner">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-8 mx-auto text-center">
            <h1 id="typingTitle"></h1>
            <p class="subtitle">คัดกรองตามประเภทคดี ประสบการณ์ พื้นที่ให้บริการ และค่าบริการ</p>
          </div>
        </div>
      </div>
    </section>


    <section class="container" style="position: relative; z-index: 1050;">
      <div class="row justify-content-center">
        <div class="col-lg-12">
          <div class="search-container">
            <form id="searchForm">
              <div class="row g-3">
                <div class="col-md-6 col-lg">
                  <label class="form-label">ประเภทคดี</label>
                  <div class="input-group position-relative">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-scale-balanced text-muted"></i></span>
                    <input type="text" id="keywordInput" name="keyword" class="form-control border-start-0 ps-2" placeholder="เช่น คดีที่ดิน, มรดก..." autocomplete="off">
                    
                    <!-- Custom Suggestion Box -->
                    <ul id="suggestionBox" class="dropdown-menu w-100 shadow-sm position-absolute" style="top: 100%; left: 0; z-index: 1050; max-height: 250px; overflow-y: auto; border-radius: 12px;"></ul>
                  </div>
                </div>

                <div class="col-md-6 col-lg">
                  <label class="form-label">จังหวัดที่ให้บริการ</label>
                  <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-location-dot text-muted"></i></span>
                      <button class="form-select border-start-0 ps-2 text-start text-muted d-flex justify-content-between align-items-center px-2" type="button" id="provinceBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <span id="provinceBtnText" class="text-truncate">เลือกจังหวัด</span>
                      </button>
                      <ul class="dropdown-menu w-100 shadow-sm p-2" id="provinceList" style="max-height: 300px; overflow-y: auto;"></ul>
                  </div>
                </div>

                <div class="col-md-6 col-lg">
                  <label class="form-label">ประสบการณ์ทำงาน</label>
                  <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-briefcase text-muted"></i></span>
                    <select class="form-select border-start-0 ps-2" name="experience" id="nameExp">
                      <option value="">ทั้งหมด</option>
                      <option value="0-1">น้อยกว่า 1 ปี</option>
                      <option value="1-3">1-3 ปี</option>
                      <option value="4-6">4-6 ปี</option>
                      <option value="7-10">7-10 ปี</option>
                      <option value="11-50">10 ปีขึ้นไป</option>
                    </select>
                  </div>
                </div>


                <div class="col-md-6 col-lg">
                  <label class="form-label">ค่าบริการ (บาท)</label>
                  <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-baht-sign text-muted"></i></span>
                    <select class="form-select border-start-0 ps-2 px-1" name="price" id="priceRange">
                      <option value="">ทั้งหมด</option>
                      <option value="0-1000">0 - 1,000</option>
                      <option value="1001-3000">1,000 - 3,000</option>
                      <option value="3001-5000">3,000 - 5,000</option>
                      <option value="5000+">5,000 ขึ้นไป</option>
                    </select>
                  </div>
                </div>

                <div class="col-md-12 col-lg-auto d-flex align-items-end">
                  <button type="submit" class="btn btn-search">ค้นหา</button>
                </div>

              </div>
            </form>

          </div>
        </div>
      </div>
    </section>
    </div>

    <!-- SNAP SECTION 2: Categories -->
    <div class="swiper-slide snap-section d-flex flex-column justify-content-center" style="min-height: 100vh; background-color: #FFFDF5;">
      <section class="container" id="categoriesSection">
      <h5 class="text-center fw-bold">หมวดหมู่คดีแนะนำ</h5>
      <div class="row g-3 row-cols-2 row-cols-md-5" id="categoryGrid">
        <div class="col text-center">
            <a href="/lawyers?keyword=คดีแพ่ง" class="d-block p-4 border-0 rounded-4 shadow-sm category-card text-decoration-none h-100 d-flex flex-column align-items-center justify-content-center">
                <div class="category-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-3">
                    <i class="fa-solid fa-briefcase fs-3"></i>
                </div>
                <div class="small fw-bold category-title">คดีแพ่ง</div>
            </a>
        </div>
        <div class="col text-center">
            <a href="/lawyers?keyword=คดีอาญา" class="d-block p-4 border-0 rounded-4 shadow-sm category-card text-decoration-none h-100 d-flex flex-column align-items-center justify-content-center">
                <div class="category-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-3">
                    <i class="fa-solid fa-shield-cat fs-3"></i>
                </div>
                <div class="small fw-bold category-title">คดีอาญา</div>
            </a>
        </div>
        <div class="col text-center">
            <a href="/lawyers?keyword=คดีครอบครัว" class="d-block p-4 border-0 rounded-4 shadow-sm category-card text-decoration-none h-100 d-flex flex-column align-items-center justify-content-center">
                <div class="category-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-3">
                    <i class="fa-solid fa-house fs-3"></i>
                </div>
                <div class="small fw-bold category-title">คดีครอบครัว</div>
            </a>
        </div>
        <div class="col text-center">
            <a href="/lawyers?keyword=คดีที่ดิน" class="d-block p-4 border-0 rounded-4 shadow-sm category-card text-decoration-none h-100 d-flex flex-column align-items-center justify-content-center">
                <div class="category-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-3">
                    <i class="fa-solid fa-building fs-3"></i>
                </div>
                <div class="small fw-bold category-title">คดีที่ดิน</div>
            </a>
        </div>
        <div class="col text-center">
            <a href="/lawyers?keyword=คดีมรดก" class="d-block p-4 border-0 rounded-4 shadow-sm category-card text-decoration-none h-100 d-flex flex-column align-items-center justify-content-center">
                <div class="category-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-3">
                    <i class="fa-solid fa-coins fs-3"></i>
                </div>
                <div class="small fw-bold category-title">คดีมรดก</div>
            </a>
        </div>
        <div class="col text-center">
            <a href="/lawyers?keyword=คดีจราจร" class="d-block p-4 border-0 rounded-4 shadow-sm category-card text-decoration-none h-100 d-flex flex-column align-items-center justify-content-center">
                <div class="category-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-3">
                    <i class="fa-solid fa-car fs-3"></i>
                </div>
                <div class="small fw-bold category-title">คดีจราจร</div>
            </a>
        </div>
        <div class="col text-center">
            <a href="/lawyers?keyword=คดีแรงงาน" class="d-block p-4 border-0 rounded-4 shadow-sm category-card text-decoration-none h-100 d-flex flex-column align-items-center justify-content-center">
                <div class="category-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-3">
                    <i class="fa-solid fa-id-card fs-3"></i>
                </div>
                <div class="small fw-bold category-title">คดีแรงงาน</div>
            </a>
        </div>
        <div class="col text-center">
            <a href="/lawyers?keyword=คดีผู้บริโภค" class="d-block p-4 border-0 rounded-4 shadow-sm category-card text-decoration-none h-100 d-flex flex-column align-items-center justify-content-center">
                <div class="category-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-3">
                    <i class="fa-solid fa-shop fs-3"></i>
                </div>
                <div class="small fw-bold category-title">คดีผู้บริโภค</div>
            </a>
        </div>
        <div class="col text-center">
            <a href="/lawyers?keyword=คดีไซเบอร์" class="d-block p-4 border-0 rounded-4 shadow-sm category-card text-decoration-none h-100 d-flex flex-column align-items-center justify-content-center">
                <div class="category-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-3">
                    <i class="fa-solid fa-laptop fs-3"></i>
                </div>
                <div class="small fw-bold category-title">คดีไซเบอร์</div>
            </a>
        </div>
        <div class="col text-center">
            <a href="/lawyers" class="d-block p-4 border-0 rounded-4 shadow-sm category-card text-decoration-none h-100 d-flex flex-column align-items-center justify-content-center">
                <div class="category-icon-wrapper rounded-circle d-flex align-items-center justify-content-center mb-3">
                    <i class="fa-solid fa-arrow-right fs-3"></i>
                </div>
                <div class="small fw-bold category-title">ดูทั้งหมด</div>
            </a>
        </div>
      </div>
      </section>
    </div>

    <div class="swiper-slide snap-section d-flex flex-column justify-content-between lawyer-section" style="min-height: 100vh;">
      <section class="container" style="margin-top: 120px;">
      <h5 class="text-center fw-bold">ทนายความแนะนำ</h5>
      
      <div class="position-relative swiper lawyer-swiper py-3 px-2">
        <div class="swiper-wrapper" id="searchResults">
        </div>
        <div class="swiper-button-prev" style="color: #1a435a;"></div>
        <div class="swiper-button-next" style="color: #1a435a;"></div>
      </div>
      </section>
    </div>
    </div>
  </main>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="/js/index.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>
