<!doctype html>
<html lang="th" data-bs-theme="light" data-theme="light">

<head>
  <%- include('../partials/head') %>
  <meta charset="UTF-8" />
  <title>FindLawyer</title>
  <link rel="stylesheet" href="/css/profile.css" />
  </head>

<body>
  <div class="container-fluid p-0">
    <div class="row g-0 min-vh-100">
      <aside class="col-md-3 col-lg-2 p-0 d-md-block sidebar-curved position-sticky top-0"
        style="height: 100vh; overflow-y: auto; overflow-x: hidden;">
        <div class="d-flex flex-column h-100">
          <a href="/" class="d-flex align-items-center gap-2" style="padding: 20px 30px 30px 30px; color: #ffffff; text-decoration: none; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
            <i class="fa-solid fa-chevron-left fs-5"></i>
            <span class="fs-6 fw-semibold">กลับหน้าหลัก</span>
          </a>
          <div class="sidebar-profile-block mb-3">
            <div class="avatar-wrapper mb-3">
              <div class="position-relative d-flex justify-content-center align-items-center bg-light sidebar-avatar-img">
                <i class="fa-solid fa-user position-absolute" style="font-size: 50px; color: #dee2e6; z-index: 1;"></i>
                <img id="sidebarPic" class="position-absolute w-100 h-100 top-0 start-0 rounded-circle object-fit-cover" alt="Profile" style="z-index: 2; display: none;" />
              </div>
              <label for="uploadNewpic" class="avatar-edit-badge" title="เปลี่ยนรูปโปรไฟล์" style="width: 32px; height: 32px; bottom: 0; right: 0;">
                <i class="fa-solid fa-camera" style="font-size: 0.85rem;"></i>
              </label>
              <input type="file" id="uploadNewpic" accept="image/jpeg, image/png, image/jpg" class="d-none" />
            </div>
            <h5 class="fw-bold text-white mb-1" id="sidebarUsername">ชื่อ-สกุลผู้ใช้งาน</h5>
            <small class="fw-semibold text-white" id="sidebarEmail">อีเมล</small>
          </div>

          <ul class="sidebar-nav-list mb-auto">
            <li>
              <a href="/profile" class="nav-link active">
                <span class="nav-icon-badge"><i class="fa-solid fa-user"></i></span>
                <span>ข้อมูลส่วนตัว</span>
              </a>
            </li>
            <li>
              <a href="/favorites" class="nav-link">
                <span class="nav-icon-badge"><i class="fa-solid fa-bookmark"></i></span>
                <span>ทนายความที่บันทึกไว้</span>
              </a>
            </li>
            <li>
              <a href="/user_reviews" class="nav-link">
                <span class="nav-icon-badge"><i class="fa-solid fa-star"></i></span>
                <span>รีวิวและความคิดเห็น</span>
              </a>
            </li>
          </ul>

          <hr class="mt-auto mb-3 mx-4" style="border-top: 1px solid rgba(255, 255, 255, 0.2); opacity: 1;" />
          <div class="d-flex justify-content-center pb-4">
            <a class="text-danger d-flex align-items-center gap-2 text-decoration-none" id="logoutBtn" onclick="Auth.clearSession()" style="cursor: pointer; font-weight: 600; font-size: 1.05rem; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
              <i class="fa-solid fa-right-from-bracket fa-rotate-180 fs-5"></i>
              <span>ออกจากระบบ</span>
            </a>
          </div>
        </div>
      </aside>
      <main class="col-md-9 ms-sm-auto col-lg-10 p-0">
        <div class="p-4 p-md-5 mx-auto" style="max-width: 1000px;">
          <div style="margin-top: 50px; margin-bottom: 24px;">
            <h2 class="fw-bold mb-2">ข้อมูลส่วนตัว</h2>
            <hr style="border-top: 2px solid #cbd5e1; opacity: 1; margin-top: 0;">
          </div>
          <div class="row g-4 mb-5">
            <div class="col-md-6">
              <a href="/favorites" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                  <div class="d-flex align-items-center">
                    <div
                      class="bg-danger bg-opacity-10 text-danger rounded-4 d-flex align-items-center justify-content-center p-3 me-4"
                      style="width: 64px; height: 64px">
                      <i class="fa-solid fa-bookmark fs-2"></i>
                    </div>
                    <div class="flex-grow-1">
                      <p class="text-muted mb-1 small fw-semibold">ทนายความที่บันทึกไว้</p>
                      <div class="d-flex align-items-baseline gap-2" style="color: #4987A4;">
                        <h2 class="fw-bold mb-0" id="savedCount">0</h2>
                        <span>คน</span>
                      </div>
                    </div>
                    <div class="text-muted fs-4">
                      <i class="fa-solid fa-chevron-right"></i>
                    </div>
                  </div>
                </div>
              </a>
            </div>

            <div class="col-md-6">
              <a href="/user_reviews" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                  <div class="d-flex align-items-center">
                    <div
                      class="bg-warning bg-opacity-10 text-warning rounded-4 d-flex align-items-center justify-content-center p-3 me-4"
                      style="width: 64px; height: 64px">
                      <i class="fa-solid fa-star fs-2"></i>
                    </div>
                    <div class="flex-grow-1">
                      <p class="text-muted mb-1 small fw-semibold">ประวัติการรีวิวของคุณ</p>
                      <div class="d-flex align-items-baseline gap-2" style="color: #4987A4;">
                        <h2 class="fw-bold mb-0" id="reviewCount">0</h2>
                        <span>รายการ</span>
                      </div>
                    </div>
                    <div class="text-muted fs-4">
                      <i class="fa-solid fa-chevron-right"></i>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          </div>

          <!-- Edit Profile Form (Card) -->
          <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <form id="editProfileform">
              <!-- Personal Info Section -->
              <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="card-header-custom border-0 pb-0 mb-0"><i class="fa-solid fa-id-card me-2"></i>ข้อมูลส่วนตัว
                </div>
                <button type="button" class="btn btn-secondary rounded-pill px-3" id="btnEditProfile">
                  <i class="fa-solid fa-pen-to-square me-1"></i>แก้ไขข้อมูล
                </button>
              </div>

              <div class="row g-4 mb-5">
                <div class="col-md-6">
                  <label for="inputName" class="form-label fw-semibold" style="color: #1A435A; font-size: 1rem;">ชื่อจริง</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                    <input type="text" class="form-control form-control-custom" id="inputName" placeholder="กรอกชื่อจริง" disabled />
                  </div>
                </div>

                <div class="col-md-6">
                  <label for="inputLastname" class="form-label fw-semibold" style="color: #1A435A; font-size: 1rem;">นามสกุล</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                    <input type="text" class="form-control form-control-custom" id="inputLastname" placeholder="กรอกนามสกุล" disabled />
                  </div>
                </div>

                <div class="col-md-6">
                  <label for="inputEmail" class="form-label fw-semibold" style="color: #1A435A; font-size: 1rem;">อีเมล</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                    <input type="email" class="form-control form-control-custom  text-muted" id="inputEmail" placeholder="example@email.com" disabled readonly />
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="card-header-custom mb-0"><i class="fa-solid fa-shield-halved me-2"></i>เปลี่ยนรหัสผ่าน</div>
              </div>

              <!-- Password Inputs -->
              <div id="passwordFieldsSection">
                <div class="row g-4">
                  <div class="col-md-12">
                    <label for="oldPassword" class="form-label fw-semibold" style="color: #1A435A; font-size: 1rem;">รหัสผ่านปัจจุบัน</label>
                    <div class="input-group position-relative">
                      <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                      <input type="password" class="form-control form-control-custom pe-5" id="oldPassword" placeholder="กรอกรหัสผ่านปัจจุบัน" disabled />
                      <span class="toggle-password position-absolute end-0 top-50 translate-middle-y me-3" onclick="togglePassword('oldPassword', this)" style="cursor: pointer; z-index: 10; color: #6c757d;">
                        <i class="fa-regular fa-eye"></i>
                      </span>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <label for="newPassword" class="form-label fw-semibold" style="color: #1A435A; font-size: 1rem;">รหัสผ่านใหม่</label>
                    <div class="input-group position-relative">
                      <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                      <input type="password" class="form-control form-control-custom pe-5" id="newPassword" placeholder="กรอกรหัสผ่านใหม่" disabled />
                      <span class="toggle-password position-absolute end-0 top-50 translate-middle-y me-3" onclick="togglePassword('newPassword', this)" style="cursor: pointer; z-index: 10; color: #6c757d;">
                        <i class="fa-regular fa-eye"></i>
                      </span>
                    </div>
                    <div id="passwordHintWrapper" style="display: none;">
                      <div class="progress mt-3" style="height: 6px; background-color: #e9ecef; border-radius: 4px">
                        <div id="passwordStrengthBar" class="progress-bar" role="progressbar" style="width: 0%; transition: width 0.3s ease"></div>
                      </div>
                      <small class="text-muted d-block mt-2 fw-medium" style="font-size: 0.65rem;">* รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร ประกอบด้วย [A-Z], [a-z], [0-9], ! @ # $ % ^ & * ( ) _ - + = { } [ ] : ; " ' < > , . ? / \ | ~ </small>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <label for="confirmNewpassword"
                      class="form-label fw-semibold" style="color: #1A435A; font-size: 1rem;">ยืนยันรหัสผ่านใหม่</label>
                    <div class="input-group position-relative">
                      <span class="input-group-text input-group-text-custom"><i class="fa-solid fa-lock"></i></span>
                      <input type="password" class="form-control form-control-custom pe-5"
                        id="confirmNewpassword" placeholder="ยืนยันรหัสผ่านใหม่อีกครั้ง" disabled />
                      <span class="toggle-password position-absolute end-0 top-50 translate-middle-y me-3" onclick="togglePassword('confirmNewpassword', this)" style="cursor: pointer; z-index: 10; color: #6c757d;">
                        <i class="fa-regular fa-eye"></i>
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="d-flex justify-content-end gap-3 mt-5">
                <button type="button" class="btn btn-cancel" id="btnCancelEdit" style="display: none">ยกเลิก</button>
                <button type="submit" class="btn btn-save-custom" id="btnSaveSubmit" style="display: none">
                  บันทึกการเปลี่ยนแปลง
                </button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <script src="/js/auth.js"></script>
  <script src="/js/profile.js"></script>
</body>

</html>