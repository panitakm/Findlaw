<!doctype html>
<html lang="th" data-bs-theme="light" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FindLawyer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/profile.css" />
    <link rel="stylesheet" href="/css/user_reviews.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js"></script>
</head>
  <body>
    <div class="container-fluid p-0">
      <div class="row g-0 min-vh-100">
        <aside class="col-md-3 col-lg-2 p-0 d-md-block sidebar-curved position-sticky top-0" style="height: 100vh; overflow-y: auto; overflow-x: hidden;">
          <div class="d-flex flex-column h-100">
            <a href="/" class="d-flex align-items-center gap-2" style="padding: 20px 30px 30px 30px; color: #ffffff; text-decoration: none; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
              <i class="fa-solid fa-chevron-left fs-5"></i>
              <span class="fs-6 fw-semibold">กลับหน้าหลัก</span>
            </a>
            
            <div class="sidebar-profile-block mb-3">
              <div class="avatar-wrapper mb-3">
              <div class="position-relative d-flex justify-content-center align-items-center bg-light sidebar-avatar-img">
                <i class="fa-solid fa-user position-absolute" style="font-size: 50px; color: #dee2e6; z-index: 1;"></i>
                <img id="sidebarPic" class="position-absolute w-100 h-100 top-0 start-0 rounded-circle object-fit-cover" alt="Profile" style="z-index: 2; display: none;" />
              </div>
                <label for="uploadNewpic" class="avatar-edit-badge" title="เปลี่ยนรูปโปรไฟล์" style="width: 32px; height: 32px; bottom: 0; right: 0;">
                  <i class="fa-solid fa-camera" style="font-size: 0.85rem;"></i>
                </label>
                <input type="file" id="uploadNewpic" accept="image/jpeg, image/png, image/jpg" class="d-none" />
              </div>
              <h5 class="fw-bold text-white mb-1" id="sidebarUsername">ชื่อ-สกุลผู้ใช้งาน</h5>
              <small class="fw-semibold text-white" id="sidebarEmail">อีเมล</small>
            </div>

            <ul class="sidebar-nav-list mb-auto">
              <li>
                <a href="/profile" class="nav-link">
                  <span class="nav-icon-badge"><i class="fa-solid fa-user"></i></span>
                  <span>ข้อมูลส่วนตัว</span>
                </a>
              </li>
              <li>
                <a href="/favorites" class="nav-link">
                  <span class="nav-icon-badge"><i class="fa-solid fa-bookmark"></i></span>
                  <span>ทนายความที่บันทึกไว้</span>
                </a>
              </li>
              <li>
                <a href="/user_reviews" class="nav-link active">
                  <span class="nav-icon-badge"><i class="fa-solid fa-star"></i></span>
                  <span>รีวิวและความคิดเห็น</span>
                </a>
              </li>
            </ul>

            <hr class="mt-auto mb-3 mx-4" style="border-top: 1px solid rgba(255, 255, 255, 0.2); opacity: 1;" />
            <div class="d-flex justify-content-center pb-4">
              <a class="text-danger d-flex align-items-center gap-2 text-decoration-none" id="logoutBtn" onclick="Auth.clearSession()" style="cursor: pointer; font-weight: 600; font-size: 1.05rem; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
                <i class="fa-solid fa-right-from-bracket fa-rotate-180 fs-5"></i>
                <span>ออกจากระบบ</span>
              </a>
            </div>
          </div>
        </aside>
        <main class="col-md-9 ms-sm-auto col-lg-10 p-0">
          <div class="p-4 p-md-5 mx-auto" style="max-width: 1000px;">
            <div style="margin-top: 50px; margin-bottom: 24px;">
              <h2 class="fw-bold mb-2" style="font-size: 2.3rem;">ประวัติการรีวิวและความคิดเห็น</h2>
              <hr style="border-top: 2px solid #cbd5e1; opacity: 1; margin-top: 0;">
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
              <div class="text-dark fw-semibold" style="font-size: 1rem;">
                <span id="totalReviewsCount">0</span> รายการ
              </div>
              <div class="d-flex gap-3 align-items-center flex-wrap">
                <div class="d-flex align-items-center gap-1">
                  <i class="fa-solid fa-arrow-up-wide-short text-muted me-2" style="font-size: 1.1rem;"></i>
                  <select id="reviewRatingSelect" class="form-select">
                    <option value="">ดูทั้งหมด</option>
                    <option value="5">5 ดาว</option>
                    <option value="4">4 ดาว</option>
                    <option value="1-3">1–3 ดาว</option>
                  </select>
                </div>
                <div class="d-flex align-items-center gap-1">
                  <select id="reviewSortSelect" class="form-select">
                    <option value="newest">รีวิวล่าสุด</option>
                    <option value="oldest">รีวิวเก่าที่สุด</option>
                    <option value="rating-high">คะแนนสูงสุด</option>
                    <option value="rating-low">คะแนนต่ำสุด</option>
                  </select>
                </div>
              </div>
            </div>
            <div id="reviewsContainer"></div>
          </div>
        </main>
      </div>
    </div>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/user_reviews.js"></script>
  </body>
</html>
