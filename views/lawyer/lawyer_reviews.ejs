<!doctype html>
<html lang="th" data-bs-theme="light" data-theme="light">
  <head>
  <%- include('../partials/head') %>
    <meta charset="UTF-8" />
    <title>FindLawyer</title>
    <link rel="stylesheet" href="/css/profile.css" />
    <link rel="stylesheet" href="/css/lawyer_reviews.css" />
      </head>
  <body>
    <div class="container-fluid p-0">
      <div class="row g-0 min-vh-100">
        <aside class="col-md-3 col-lg-2 p-0 d-md-block sidebar-curved position-sticky top-0" style="height: 100vh; overflow-y: auto">
          <div class="d-flex flex-column h-100">
            <a href="/" class="d-flex align-items-center gap-2 sidebar-back-link">
              <i class="fa-solid fa-chevron-left fs-5"></i>
              <span class="fs-6 fw-semibold">กลับหน้าหลัก</span>
            </a>
            <ul class="sidebar-nav-list mb-auto" style="margin-top: 30px;">
              <li>
                <a href="/lawyer_dashboard" class="nav-link">
                  <span class="nav-icon-badge"><i class="fa-solid fa-chart-column"></i></span>
                  <span>ภาพรวมข้อมูล</span>
                </a>
              </li>
              <li>
                <a href="/lawyer_edit" class="nav-link">
                  <span class="nav-icon-badge"><i class="fa-solid fa-user-pen"></i></span>
                  <span>แก้ไขข้อมูลส่วนตัว</span>
                </a>
              </li>
              <li>
                <a href="/lawyer_reviews" class="nav-link active">
                  <span class="nav-icon-badge"><i class="fa-solid fa-star"></i></span>
                  <span>ตรวจสอบรีวิว</span>
                </a>
              </li>
            </ul>

            <hr class="mt-auto mb-3 mx-4" style="border-top: 1px solid rgba(255, 255, 255, 0.2); opacity: 1;" />
            <div class="d-flex justify-content-center pb-4">
              <a class="text-danger d-flex align-items-center gap-2 text-decoration-none sidebar-logout-link" id="logoutBtn" onclick="Auth.clearSession()">
                <i class="fa-solid fa-right-from-bracket fa-rotate-180 fs-5"></i>
                <span>ออกจากระบบ</span>
              </a>
            </div>
          </div>
        </aside>

        <main class="col-md-9 ms-sm-auto col-lg-10 p-0">
          <div class="p-4 p-md-5 mx-auto" style="max-width: 1000px;">
            <div style="margin-top: 50px; margin-bottom: 24px;">
              <h2 class="fw-bold mb-2">ตรวจสอบรีวิวและตอบกลับ</h2>
              <hr style="border-top: 2px solid #cbd5e1; opacity: 1; margin-top: 0;">
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5 bg-white">
              <div class="row align-items-center">
                <div class="col-md-4 text-center border-end-md mb-4 mb-md-0 border-opacity-25" style="border-color: #1A435A !important">
                  <div class="display-3 fw-semibold mb-2" id="avgRatingDisplay" style="color: #1A435A;">0.0</div>
                  <div class="text-warning fs-4 mb-2" id="avgStarsDisplay">
                    <i class="fa-regular fa-star text-muted"></i>
                    <i class="fa-regular fa-star text-muted"></i>
                    <i class="fa-regular fa-star text-muted"></i>
                    <i class="fa-regular fa-star text-muted"></i>
                    <i class="fa-regular fa-star text-muted"></i>
                  </div>
                  <p class="mb-0 fw-medium" id="totalReviewsDisplay">(0 รีวิว)</p>
                </div>
                <div class="col-md-8 px-md-5">
                  <div class="rating-bar-group">

                    <div class="d-flex align-items-center mb-2">
                      <span class="text-muted d-flex gap-1 align-items-center justify-content-end me-3" style="width: 80px; flex-shrink: 0;">
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                      </span>
                      <div class="progress flex-grow-1" style="height: 10px; background-color: #e9ecef">
                        <div
                          class="progress-bar bg-warning rounded-pill"
                          id="bar5"
                          role="progressbar"
                          style="width: 0%"
                          aria-valuenow="0"
                          aria-valuemin="0"
                          aria-valuemax="100"
                        ></div>
                      </div>
                      <span class="ms-3 text-muted fw-semibold" id="count5" style="min-width: 30px">0</span>
                    </div>

                    <div class="d-flex align-items-center mb-2">
                      <span class="text-muted d-flex gap-1 align-items-center justify-content-end me-3" style="width: 80px; flex-shrink: 0;">
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                      </span>
                      <div class="progress flex-grow-1" style="height: 10px; background-color: #e9ecef">
                        <div
                          class="progress-bar bg-warning rounded-pill"
                          id="bar4"
                          role="progressbar"
                          style="width: 0%"
                          aria-valuenow="0"
                          aria-valuemin="0"
                          aria-valuemax="100"
                        ></div>
                      </div>
                      <span class="ms-3 text-muted fw-semibold" id="count4" style="min-width: 30px">0</span>
                    </div>

                    <div class="d-flex align-items-center mb-2">
                      <span class="text-muted d-flex gap-1 align-items-center justify-content-end me-3" style="width: 80px; flex-shrink: 0;">
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                      </span>
                      <div class="progress flex-grow-1" style="height: 10px; background-color: #e9ecef">
                        <div
                          class="progress-bar bg-warning rounded-pill"
                          id="bar3"
                          role="progressbar"
                          style="width: 0%"
                          aria-valuenow="0"
                          aria-valuemin="0"
                          aria-valuemax="100"
                        ></div>
                      </div>
                      <span class="ms-3 text-muted fw-semibold" id="count3" style="min-width: 30px">0</span>
                    </div>
                    
                    <div class="d-flex align-items-center mb-2">
                      <span class="text-muted d-flex gap-1 align-items-center justify-content-end me-3" style="width: 80px; flex-shrink: 0;">
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i>
                      </span>
                      <div class="progress flex-grow-1" style="height: 10px; background-color: #e9ecef">
                        <div
                          class="progress-bar bg-warning rounded-pill"
                          id="bar2"
                          role="progressbar"
                          style="width: 0%"
                          aria-valuenow="0"
                          aria-valuemin="0"
                          aria-valuemax="100"
                        ></div>
                      </div>
                      <span class="ms-3 text-muted fw-semibold" id="count2" style="min-width: 30px">0</span>
                    </div>
                    
                    <div class="d-flex align-items-center mb-2">
                      <span class="text-muted d-flex gap-1 align-items-center justify-content-end me-3" style="width: 80px; flex-shrink: 0;">
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i></span>
                      <div class="progress flex-grow-1" style="height: 10px; background-color: #e9ecef">
                        <div
                          class="progress-bar bg-warning rounded-pill"
                          id="bar1"
                          role="progressbar"
                          style="width: 0%"
                          aria-valuenow="0"
                          aria-valuemin="0"
                          aria-valuemax="100"
                        ></div>
                      </div>
                      <span class="ms-3 text-muted fw-semibold" id="count1" style="min-width: 30px">0</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
              <div class="filter-pills d-flex gap-2 flex-wrap">
                <button class="btn btn-filter active" onclick="filterReviews('all')">ทั้งหมด</button>
                <button class="btn btn-filter" onclick="filterReviews('need-reply')">ยังไม่ได้ตอบกลับ</button>
                <button class="btn btn-filter" onclick="filterReviews('5')">5 ดาว</button>
                <button class="btn btn-filter" onclick="filterReviews('4')">4 ดาว</button>
                <button class="btn btn-filter" onclick="filterReviews('1-3')">1-3 ดาว</button>
              </div>
              <div class="sort-dropdown">
                <select id="reviewSortSelect" class="form-select form-select-sm border-0 shadow-sm form-control-theme" style="border-radius: 20px; padding: 8px 32px 8px 16px" onchange="renderReviews()">
                  <option value="newest">ใหม่ล่าสุด</option>
                  <option value="oldest">เก่าที่สุด</option>
                  <option value="rating-high">คะแนนสูงสุด</option>
                  <option value="rating-low">คะแนนต่ำสุด</option>
                </select>
              </div>
            </div>

            <div id="reviewsContainer" class="d-flex flex-column gap-4">
            </div>
          </div>
        </main>
      </div>
    </div>



    <!-- Modal สำหรับรายงานความไม่เหมาะสม -->
    <div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px)">
          <div class="modal-header border-bottom-0 pb-0 mt-2">
            <h5 class="modal-title fw-bold fs-5" id="reportModalLabel">รายงานรีวิว</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body pt-3 pb-4 px-4">
            <form id="reportForm">
              <input type="hidden" id="reportReviewId" value="" />
              <input type="hidden" id="reportTarget" value="" />

              <div class="mb-3">
                <select class="form-select bg-light" id="reportReason" style="border-radius: 12px; border: 1px solid #dee2e6; padding: 10px 15px;" required>
                  <option value="" selected disabled>กรุณาเลือกเหตุผลการรายงาน...</option>
                  <option value="เนื้อหาไม่เหมาะสม">เนื้อหาไม่เหมาะสม</option>
                  <option value="สแปมหรือโฆษณา">สแปมหรือโฆษณา</option>
                  <option value="คุกคามหรือใช้คำหยาบคาย">คุกคามหรือใช้คำหยาบคาย</option>
                  <option value="ข้อมูลเป็นเท็จหรือไม่ถูกต้อง">ข้อมูลเป็นเท็จหรือไม่ถูกต้อง</option>
                  <option value="อื่นๆ">อื่นๆ</option>
                </select>
              </div>

              <div class="text-end mt-2">
                <button type="submit" class="btn text-white px-4 rounded-pill fw-semibold shadow-sm" style="background-color: #4987A4; border: 1px solid rgba(26, 67, 90, 0.2); transition: all 0.3s ease;">ส่งรายงาน</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/lawyer_reviews.js"></script>
  </body>
</html>

